{
  "manifest_version": 3,
  "name": "抖音私信表情包可视化提取器",
  "version": "2.0",
  "description": "支持网页内可视化勾选、全选，一键下载到 douyin-emoji 文件夹",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.douyin.com/*"
  ],
  "action": {
    "default_title": "点击在抖音页面唤醒提取悬浮球",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}